# ---- CoinGecko credentials -------------------------------------------------
# Public (no key) works for the free tier with strict rate limits.
# Demo key -> "demo" | Pro key -> "pro"
COINGECKO_API_KEY=
COINGECKO_KEY_TYPE=demo

# ---- Market ---------------------------------------------------------------
# Pair is BASE/QUOTE. Base and quote are CoinGecko coin ids.
# The bot computes BASE/QUOTE as (base price in USD) / (quote price in USD).
PAIR=BNB/USDT
BASE_ID=binancecoin
QUOTE_ID=tether

# ---- Strategy -------------------------------------------------------------
# "recent" moving average period (ticks) vs "longer" moving average period.
SHORT_PERIOD=10
LONG_PERIOD=30
# sma | ema
MA_TYPE=sma

# ---- Feed -----------------------------------------------------------------
# "binance" streams the live market over a websocket - real time, and the
# only option that can actually trade a crossover. "coingecko" polls the
# aggregate price, which is a minute or two behind the market.
FEED_SOURCE=binance

# Binance market. "perp" is the USD-M perpetual (BINANCE:BNBUSDT.P on
# TradingView); "spot" is the spot market.
BINANCE_MARKET=perp
BINANCE_SYMBOL=BNBUSDT

# Ticks are resampled into bars of this length and the moving averages run
# over bar closes. 60000 means one bar is one minute, so a fast average of
# 10 covers ten minutes.
BAR_MS=60000

# Only used when FEED_SOURCE=coingecko.
POLL_MS=20000
MAX_HISTORY=2000

# ---- Paper trading --------------------------------------------------------
INITIAL_QUOTE=10000
# taker fee per side (0.001 = 0.1%)
FEE_RATE=0.001
# fraction of free quote balance deployed per buy
BUY_FRACTION=0.98
# ignore signals where the order would be smaller than this (quote ccy)
MIN_ORDER_QUOTE=10

# ---- Server ---------------------------------------------------------------
PORT=3000

# ---- Where state is written ------------------------------------------------
# On a container host these point at the mounted volume so the bot keeps its
# price history, positions and fills across restarts and redeploys.
DATA_DIR=./data
LOG_DIR=./logs

# ---- Dashboard authentication ----------------------------------------------
# Leave AUTH_PASSWORD empty to run without a login (fine on a laptop, unsafe
# anywhere else). When set, the dashboard and the API require HTTP Basic.
AUTH_USER=admin
AUTH_PASSWORD=
# Optional fixed secret for the session cookie. When empty it is derived from
# the password, so rotating the password invalidates existing sessions.
AUTH_SECRET=
